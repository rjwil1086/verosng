; AHCI storport miniport. Boot-start so a class 0106 controller can load.
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\storahci","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\storahci","Group",0x00000000,"SCSI Miniport"
HKLM,"SYSTEM\CurrentControlSet\Services\storahci","ImagePath",0x00020000,"system32\drivers\storahci.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\storahci","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\storahci","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\storahci","Tag",0x00010001,0x00000020
